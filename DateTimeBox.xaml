<UserControl x:Class="SidhawanForProfsAndAdmins.DateTimeBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SidhawanForProfsAndAdmins"
             Width="150" Height="25">
    <Grid>
        <Border x:Name="Box" Background="White" BorderBrush="{StaticResource BrandDark}"
                BorderThickness="2" CornerRadius="2" Cursor="Hand"
                MouseLeftButtonUp="Box_Click">
            <Grid>
                <local:Icon File="calendar" Width="18" Height="18" HorizontalAlignment="Left"
                            Margin="4,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="ValueText" FontSize="12" VerticalAlignment="Center"
                           Margin="28,0,4,0" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="{StaticResource BrandDark}" BorderThickness="2"
                    CornerRadius="10" Padding="10" Margin="0,4,10,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel>
                    <Calendar x:Name="Cal"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Style="{StaticResource PillButton}" Content="Clear" Width="70" Height="28"
                                FontSize="13" Margin="0,0,8,0" Click="Clear_Click"/>
                        <Button Style="{StaticResource PillButton}" 
                                Content="OK" Width="70" Height="28" FontSize="13" Click="Ok_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>